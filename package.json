{
  "name": "mailrules",
  "version": "0.2.1",
  "description": "JavaScript and TypeScript email validation: disposable email detection, blocklists, allowlists, custom rules and domain typo suggestions.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/esm/core.d.ts",
        "default": "./dist/esm/core.js"
      },
      "require": {
        "types": "./dist/cjs/core.d.ts",
        "default": "./dist/cjs/core.js"
      }
    },
    "./package.json": "./package.json",
    "./schema": {
      "import": {
        "types": "./dist/esm/schema.d.ts",
        "default": "./dist/esm/schema.js"
      },
      "require": {
        "types": "./dist/cjs/schema.d.ts",
        "default": "./dist/cjs/schema.js"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/esm/zod.d.ts",
        "default": "./dist/esm/zod.js"
      },
      "require": {
        "types": "./dist/cjs/zod.d.ts",
        "default": "./dist/cjs/zod.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/email-validation-javascript.md",
    "docs/releasing.md"
  ],
  "keywords": [
    "email",
    "validation",
    "javascript",
    "typescript",
    "nodejs",
    "email-validation",
    "email-validator",
    "disposable-email",
    "disposable-email-domains",
    "temporary-email",
    "blocklist",
    "allowlist",
    "whitelist",
    "blacklist",
    "email-typo",
    "form-validation"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "check": "npm run format:check && npm run typecheck && npm test && npm run test:package",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.json\" \"*.md\" \"docs/{releasing,email-validation-javascript}.md\" \".github/**/*.yml\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.json\" \"*.md\" \"docs/{releasing,email-validation-javascript}.md\" \".github/**/*.yml\" \".prettierrc.json\""
  },
  "dependencies": {
    "fakeout": "^1.0.128",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^22.20.5",
    "@types/validator": "^13.15.10",
    "esbuild": "^0.25.12",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RivierGrullon/mailrules.git"
  },
  "homepage": "https://github.com/RivierGrullon/mailrules#readme",
  "bugs": {
    "url": "https://github.com/RivierGrullon/mailrules/issues"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "bin": {
    "mailrules": "./dist/esm/cli.js"
  }
}
